<%- include('partials/header') %>
    <main>
        <h1>Project Details</h1>
        <h2>
            <%= projectDetails.title %>
        </h2>
        <p>
            <%= projectDetails.description %>
        </p>
        <p>
            Location: <%= projectDetails.location %>
                <br>
                <span>
                    Project Date: <%= projectDetails.project_date %>
                </span>
        </p>

        <span>
            Partner: <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </span>

        <h3>
            Categories
        </h3>
        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a>
            <p>
                <a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a>
            </p>
            <% } %>

        <% if (isLoggedIn) { %>
            <% if (isVolunteering) { %>
                <p>You are volunteering for this project.</p>
                <a href="/remove-volunteer/<%= projectDetails.project_id %>">Remove yourself as a volunteer</a>
                <% } else { %>
                    <a href="/volunteer/<%= projectDetails.project_id %>">Volunteer for this project</a>
                    <% } %>
                        <% } %>
    </main>
    <%- include('partials/footer') %>